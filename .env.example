# Copy this file to backend/.env and adjust as needed.

# Local dev: SQLite file (created automatically)
DATABASE_URL=sqlite:///./transcriptions.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/speech

# Whisper model: tiny | base | small | medium | large-v3
# base = fast on CPU and good for Hinglish. Use small/medium for better accuracy if you have the CPU/GPU.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

CORS_ORIGINS=*
